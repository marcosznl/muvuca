{
  "name": "muvuca-desktop",
  "productName": "Muvuca",
  "version": "1.4.4",
  "description": "Muvuca para Mac",
  "main": "main.js",
  "private": true,
  "author": "marcos",
  "scripts": {
    "start": "electron .",
    "dist": "native/build.sh && electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "uiohook-napi@1.5.5": true
  },
  "build": {
    "appId": "br.malegna.muvuca",
    "afterSign": "build/after-sign.js",
    "productName": "Muvuca",
    "copyright": "Feito pela galera da Malegna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "picker-preload.js",
      "picker.html",
      "offline.html",
      "package.json",
      "node_modules/uiohook-napi/**/*",
      "node_modules/node-gyp-build/**/*",
      "build/trayTemplate*.png",
      "build/tray-win*.png",
      "build/badge*.png"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Muvuca usa o microfone para você falar nas chamadas.",
        "NSCameraUsageDescription": "O Muvuca usa a câmera quando você liga o vídeo numa chamada.",
        "NSAudioCaptureUsageDescription": "O Muvuca captura o som do computador quando você transmite a tela com áudio.",
        "LSMinimumSystemVersion": "12.0"
      },
      "artifactName": "Muvuca-${version}-${arch}-mac.${ext}",
      "extraResources": [
        {
          "from": "build/bin",
          "to": "bin",
          "filter": [
            "muvuca-audio"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Muvuca",
      "artifactName": "Muvuca-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Muvuca-${version}-${arch}-windows.${ext}",
      "extraResources": [
        {
          "from": "build/bin",
          "to": "bin",
          "filter": [
            "muvuca-audio.exe"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Muvuca",
      "uninstallDisplayName": "Muvuca",
      "deleteAppDataOnUninstall": false,
      "buildUniversalInstaller": false
    },
    "npmRebuild": false,
    "toolsets": {
      "nsis": "1.2.1"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
