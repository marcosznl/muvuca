# Configuração do Muvuca. Copie para .env (cp .env.example .env) e preencha.
# O .env fica fora do git: nunca publique o seu.

# ---- Obrigatórios ----

# Chave e segredo do servidor de voz (LiveKit). Invente os dois (o segredo com 32+ caracteres), por exemplo:
#   openssl rand -hex 8    (chave)
#   openssl rand -hex 32   (segredo)
LIVEKIT_API_KEY=troque-pela-sua-chave
LIVEKIT_API_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Código de acesso: quem cria conta com ele entra no servidor principal (passe só para os amigos)
ACCESS_PASSWORD=troque-por-um-codigo-dificil

# Seu nome de usuário: essa conta vira dona do servidor principal (sem isso, é a primeira conta criada)
OWNER_USERNAME=seu-usuario

# ---- Endereço público (escolha um dos dois jeitos) ----

# 1) DuckDNS (grátis, o IP de casa muda sozinho): crie o subdomínio em https://www.duckdns.org
#    e cole aqui o nome (sem .duckdns.org) e o token da sua conta. Vários: separe por vírgula (o primeiro é o principal).
DUCKDNS_SUBDOMAIN=seu-subdominio
DUCKDNS_TOKEN=seu-token-do-duckdns

# 2) Domínio próprio: deixe DUCKDNS_* vazios e preencha (o DNS do domínio precisa apontar para o seu IP público)
DOMAIN=

# Porta extra para o site no IPv4 (quando a operadora ou o roteador não deixam usar a 443). Vazio = só 443
PUBLIC_PORT=8443

# ---- Opcionais ----

# Busca de músicas do YouTube no Assistir Junto (chave da YouTube Data API v3, no Google Cloud). Sem ela, cola-se o link do vídeo
YOUTUBE_API_KEY=
# Busca de GIFs no chat (chave da API do Giphy, em developers.giphy.com). Sem ela, os GIFs ficam indisponíveis
GIPHY_API_KEY=
# Bot "Muvuca" do Discord (/tela: salas para compartilhar a tela pelo navegador). Crie a aplicação em
# discord.com/developers/applications e preencha com os dados dela:
#   General Information: Application ID (DISCORD_CLIENT_ID), Public Key (DISCORD_PUBLIC_KEY) e, em
#     Interactions Endpoint URL, https://<seu endereço>/discord/interacoes
#   Bot: token (DISCORD_BOT_TOKEN), só para cadastrar o /tela; o app não entra como bot no servidor
#   OAuth2: Client Secret (DISCORD_CLIENT_SECRET) e, em Redirects, https://<seu endereço>/tela/callback
# <seu endereço> é o mesmo de "Link para os amigos", com a porta se tiver.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
